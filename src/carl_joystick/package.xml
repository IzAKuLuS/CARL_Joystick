<?xml version="1.0"?>
<package format="3">
  <name>carl_joystick</name>
  <version>0.1.0</version>
  <description>Touch joystick control for CARL through its ROS bridge</description>
  <maintainer email="avlab@cpp.edu">AV Lab</maintainer>
  <license>MIT</license>
  <depend>rclpy</depend>
  <depend>carl_msgs</depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-fastapi</exec_depend>
  <exec_depend>python3-uvicorn</exec_depend>
  <exec_depend>python3-websockets</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>python3-httpx</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
